#====================================================
# METIS 5.2.1 shared library
#====================================================

# nticLBM integration wrapper; upstream files under src/ remain unmodified.
set(NTIC_METIS_INCLUDE_DIR "${CMAKE_BINARY_DIR}/3rdParties/METIS/include")
file(MAKE_DIRECTORY "${NTIC_METIS_INCLUDE_DIR}")
file(READ "${NTIC_THIRD_PARTY_ROOT}/METIS/src/include/metis.h" NTIC_METIS_HEADER)
file(WRITE "${NTIC_METIS_INCLUDE_DIR}/metis.h"
    "/* Generated by nticLBM; upstream metis.h follows unchanged. */\n#define IDXTYPEWIDTH 64\n#define REALTYPEWIDTH 64\n${NTIC_METIS_HEADER}")

file(GLOB NTIC_METIS_SOURCES CONFIGURE_DEPENDS
    "${NTIC_THIRD_PARTY_ROOT}/METIS/src/libmetis/*.c"
)
add_library(ntic_metis SHARED ${NTIC_METIS_SOURCES})
add_library(METIS::METIS ALIAS ntic_metis)
target_include_directories(
    ntic_metis
    PUBLIC "${NTIC_METIS_INCLUDE_DIR}"
    PRIVATE "${NTIC_THIRD_PARTY_ROOT}/METIS/src/libmetis"
)
target_link_libraries(
    ntic_metis
    PRIVATE
    GKlib
)

if(APPLE)
    set(NTIC_METIS_LOADER_PATH "@loader_path")
elseif(UNIX)
    set(NTIC_METIS_LOADER_PATH "$ORIGIN")
else()
    set(NTIC_METIS_LOADER_PATH "")
endif()

set_target_properties(
    ntic_metis
    PROPERTIES
    OUTPUT_NAME metis
    VERSION 5.2.1
    SOVERSION 5
    C_STANDARD 99
    POSITION_INDEPENDENT_CODE ON
    WINDOWS_EXPORT_ALL_SYMBOLS ON
    BUILD_RPATH "${NTIC_METIS_LOADER_PATH}"
    INSTALL_RPATH "${NTIC_METIS_LOADER_PATH}"
    LIBRARY_OUTPUT_DIRECTORY "${NTIC_THIRD_PARTY_LIB_DIR}"
    RUNTIME_OUTPUT_DIRECTORY "${NTIC_THIRD_PARTY_LIB_DIR}"
    ARCHIVE_OUTPUT_DIRECTORY "${NTIC_THIRD_PARTY_LIB_DIR}"
)
foreach(NTIC_CONFIG DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set_target_properties(
        ntic_metis
        PROPERTIES
        LIBRARY_OUTPUT_DIRECTORY_${NTIC_CONFIG} "${NTIC_THIRD_PARTY_LIB_DIR}"
        RUNTIME_OUTPUT_DIRECTORY_${NTIC_CONFIG} "${NTIC_THIRD_PARTY_LIB_DIR}"
        ARCHIVE_OUTPUT_DIRECTORY_${NTIC_CONFIG} "${NTIC_THIRD_PARTY_LIB_DIR}"
    )
endforeach()

install(TARGETS ntic_metis LIBRARY DESTINATION lib RUNTIME DESTINATION lib)
